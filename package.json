{
  "name": "psalm-stage",
  "version": "0.2.0",
  "license": "BSD-3-Clause",
  "homepage": "https://adedayo.github.io/psalm-stage/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adedayo/psalm-stage.git"
  },
  "bugs": {
    "url": "https://github.com/adedayo/psalm-stage/issues"
  },
  "scripts": {
    "ng": "ng",
    "prestart": "lsof -ti:4200 | xargs kill -9 2>/dev/null || true",
    "start": "ng serve",
    "kill-port": "lsof -ti:4200 | xargs kill -9 2>/dev/null || true",
    "build": "ng build",
    "prepare:sidecar": "node scripts/prepare-cli-sidecar.mjs",
    "prepare:sidecar:debug": "node scripts/prepare-cli-sidecar.mjs --debug",
    "build:desktop": "npm run prepare:sidecar && ng build",
    "package": "ng build && tauri build",
    "package:debug": "ng build && tauri build --debug",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tauri": "tauri"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "22.0.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@spartan-ng/brain": "^1.9.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "postcss": "^8.5.32",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@spartan-ng/cli": "^1.9.0",
    "@tauri-apps/cli": "^2.12.4",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
