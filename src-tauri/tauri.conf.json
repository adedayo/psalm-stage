{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Psalm Stage",
  "version": "0.1.0",
  "identifier": "org.psalmstage.app",
  "build": {
    "frontendDist": "../dist/psalm-stage/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Psalm Stage",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/psalm-stage-cli"
    ],
    "category": "Music",
    "shortDescription": "Live worship multitrack playback and stage hardware controller",
    "longDescription": "High-performance live worship multitrack playback, sample-accurate synthesized metronome, section jumping, infinite looping, and universal MIDI stage hardware controller.",
    "copyright": "Copyright © 2026 Dr. Dayo Adetoye",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
